---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  const categorySet = new Set<string>();
  for (const post of posts) {
    categorySet.add(post.slug.split('/')[0]);
  }

  return [...categorySet].map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter((p) => p.slug.split('/')[0] === category)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={category}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12">
      <a href="/categories" class="text-xs font-mono text-zinc-400 hover:text-indigo-500 transition-colors mb-4 inline-block">← ALL CATEGORIES</a>
      <h1 class="text-3xl font-bold text-zinc-800 dark:text-zinc-100 tracking-tight">{category}</h1>
      <p class="text-zinc-500 mt-2 font-mono text-sm">{posts.length} posts</p>
    </div>

    <div class="relative pl-8 border-l border-zinc-300 dark:border-zinc-800 space-y-8">
      <div class="absolute -left-[5px] top-0 w-2.5 h-2.5 bg-zinc-300 dark:bg-zinc-800 rounded-full border-2 border-white dark:border-zinc-950"></div>

      {posts.map((post) => (
        <a
          href={`/posts/${post.slug}`}
          class="group block relative pl-4 transition-all duration-300 hover:translate-x-2"
        >
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-6">
            <time datetime={post.data.date.toISOString()} class="text-xs font-mono text-zinc-500 min-w-[5rem]">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}
            </time>

            <div class="flex-1">
              <h3 class="text-lg font-medium text-zinc-700 dark:text-zinc-300 group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition-colors">
                {post.data.title}
              </h3>
              {post.data.tags && (
                <div class="flex gap-2 mt-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {post.data.tags.map((tag) => (
                    <span class="text-[10px] text-zinc-500 dark:text-zinc-600 font-mono inline-flex items-center gap-0.5">
                      <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" />
                      </svg>
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
