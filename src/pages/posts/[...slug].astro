---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// 计算字数和阅读时间
const wordCount = post.body.replace(/\s+/g, '').length;
const readingTime = Math.max(1, Math.ceil(wordCount / 400));

const tocHeadings = headings.filter(h => h.depth <= 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="max-w-3xl mx-auto">
    <article>
      <!-- 文章头部 -->
      <header class="mb-10">
        <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 mb-4 leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}
            </time>
          </span>

          {post.data.categories && post.data.categories.length > 0 && (
            <>
              <span>|</span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                {post.data.categories.join(', ')}
              </span>
            </>
          )}

          <span>|</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            {wordCount}
          </span>

          <span>|</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {readingTime}分钟
          </span>

          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span>|</span>
              <span class="inline-flex items-center gap-1.5 flex-wrap">
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`} class="hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>{tag}</a>
                ))}
              </span>
            </>
          )}
        </div>
      </header>

      <!-- 文章正文 -->
      <div class="prose prose-zinc prose-lg max-w-none dark:prose-invert
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-zinc-800 dark:prose-headings:text-zinc-100
        prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:text-indigo-500 dark:hover:prose-a:text-indigo-300
        prose-pre:bg-zinc-100 dark:prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-200 dark:prose-pre:border-zinc-800
        prose-code:text-indigo-600 dark:prose-code:text-indigo-300 prose-code:bg-zinc-100 dark:prose-code:bg-zinc-900/50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
        prose-img:rounded-xl prose-img:border prose-img:border-zinc-200 dark:prose-img:border-zinc-800"
      >
        <Content />
      </div>
    </article>
  </div>

  <!-- Floating TOC Dynamic Island -->
  {tocHeadings.length > 0 && (
    <div id="toc-island" class="fixed right-6 top-1/2 -translate-y-1/2 z-40">
      <div
        id="toc-capsule"
        class="toc-capsule bg-white/80 dark:bg-zinc-900/50 backdrop-blur-xl border border-zinc-200/50 dark:border-white/5 shadow-lg dark:shadow-black/50 ring-1 ring-zinc-900/5 dark:ring-white/10 overflow-hidden cursor-pointer"
      >
        <!-- Header row: always visible, acts as the pill when collapsed -->
        <div id="toc-header" class="flex items-center gap-2 px-3 py-2.5 select-none">
          <svg class="toc-icon w-4 h-4 text-zinc-500 dark:text-zinc-400 flex-shrink-0 transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <span id="toc-progress" class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 tabular-nums min-w-[2ch] text-center transition-opacity duration-300">0%</span>
          <!-- Close X, visible only when expanded -->
          <button id="toc-close" class="toc-close-btn p-0.5 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 transition-all duration-300 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800 ml-auto" aria-label="Close">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <!-- Expandable content -->
        <div id="toc-body" class="toc-body">
          <ul class="px-3 pb-3 space-y-0.5">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-slug={h.slug}
                  data-depth={h.depth}
                  class="toc-link group/item flex items-center gap-2 py-1 rounded-lg px-2 -mx-1 transition-all duration-300 hover:bg-zinc-100/80 dark:hover:bg-white/5 text-zinc-500 dark:text-zinc-500"
                  style={`padding-left: ${0.5 + (h.depth - 1) * 0.75}rem`}
                >
                  <span class="toc-dot w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700 flex-shrink-0 transition-all duration-500"></span>
                  <span class="text-[13px] leading-snug truncate transition-colors duration-300 group-hover/item:text-zinc-800 dark:group-hover/item:text-zinc-200">
                    {h.text}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )}
</BaseLayout>

<style>
  /* === Capsule: the single morphing container === */
  /* Collapsed state: defines the COLLAPSING transition (expanded → collapsed) */
  .toc-capsule {
    width: 5.5rem;
    max-height: 2.75rem;
    border-radius: 9999px;
    transition:
      width 500ms cubic-bezier(0.16, 1, 0.3, 1),
      max-height 500ms cubic-bezier(0.16, 1, 0.3, 1),
      border-radius 500ms 200ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-capsule:hover:not(.expanded) {
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
    transform: scale(1.05);
  }

  /* Expanded state: defines the EXPANDING transition (collapsed → expanded) */
  .toc-capsule.expanded {
    width: 17rem;
    max-height: 60vh;
    border-radius: 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition:
      width 500ms cubic-bezier(0.16, 1, 0.3, 1),
      max-height 500ms cubic-bezier(0.16, 1, 0.3, 1),
      border-radius 0ms,
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* === Body: hidden when collapsed === */
  .toc-body {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition:
      opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
      max-height 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-capsule.expanded .toc-body {
    opacity: 1;
    max-height: 55vh;
  }

  /* === Close button: hidden when collapsed === */
  .toc-close-btn {
    opacity: 0;
    width: 0;
    overflow: hidden;
    transition: opacity 300ms, width 300ms;
  }

  .toc-capsule.expanded .toc-close-btn {
    opacity: 1;
    width: 1.5rem;
  }

  /* === Progress text fades when expanded === */
  .toc-capsule.expanded #toc-progress {
    opacity: 0;
    width: 0;
    overflow: hidden;
  }

  /* === Icon color when expanded === */
  .toc-capsule.expanded .toc-icon {
    color: rgb(99, 102, 241);
  }

  /* === Island visibility === */
  #toc-island {
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  #toc-island.island-hidden {
    opacity: 0;
    transform: translate(0, -50%) scale(0.8);
    pointer-events: none;
  }

  /* === Active TOC link === */
  .toc-link.active {
    color: var(--color-indigo-600, #4f46e5);
    background-color: rgba(99, 102, 241, 0.06);
  }

  :root.dark .toc-link.active {
    color: rgb(129, 140, 248);
    background-color: rgba(99, 102, 241, 0.08);
  }

  .toc-link.active .toc-dot {
    background-color: rgb(99, 102, 241);
    width: 6px;
    height: 6px;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.5);
  }

  /* === Scrollbar === */
  .toc-capsule::-webkit-scrollbar {
    width: 3px;
  }
  .toc-capsule::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-capsule::-webkit-scrollbar-thumb {
    background: rgba(161, 161, 170, 0.3);
    border-radius: 10px;
  }

  /* === Responsive === */
  @media (max-width: 1024px) {
    #toc-island { right: 0.75rem; }
  }
  @media (max-width: 640px) {
    #toc-island { display: none; }
  }
</style>

<script>
  function initTocIsland() {
    const island = document.getElementById('toc-island');
    const capsule = document.getElementById('toc-capsule');
    const header = document.getElementById('toc-header');
    const closeBtn = document.getElementById('toc-close');
    const progress = document.getElementById('toc-progress');
    const links = document.querySelectorAll('.toc-link');

    if (!island || !capsule || !header) return;

    let isOpen = false;
    let autoCloseTimer: ReturnType<typeof setTimeout> | null = null;
    let lastActiveSlug = '';
    let userClosed = false;
    let manualOpen = false; // user clicked to open — never auto-close
    let isHovering = false;
    let currentObserver: IntersectionObserver | null = null;

    function expand() {
      isOpen = true;
      userClosed = false;
      capsule!.classList.add('expanded');
    }

    function collapse() {
      if (isHovering) return;
      isOpen = false;
      manualOpen = false;
      capsule!.classList.remove('expanded');
    }

    function cancelAutoClose() {
      if (autoCloseTimer) { clearTimeout(autoCloseTimer); autoCloseTimer = null; }
    }

    function scheduleAutoClose(ms: number) {
      if (manualOpen) return; // never auto-close a manually opened panel
      cancelAutoClose();
      autoCloseTimer = setTimeout(() => { collapse(); }, ms);
    }

    // Auto-expand on section change, then collapse after delay
    function flashOpen() {
      if (userClosed || manualOpen) return;
      expand();
      scheduleAutoClose(2500);
    }

    // Header click toggles
    header!.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#toc-close')) return;
      cancelAutoClose();
      if (isOpen) {
        userClosed = true;
        manualOpen = false;
        isHovering = false;
        collapse();
      } else {
        manualOpen = true;
        expand();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      cancelAutoClose();
      userClosed = true;
      isHovering = false;
      collapse();
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (isOpen && !island!.contains(e.target as Node)) {
        cancelAutoClose();
        isHovering = false;
        collapse();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) { cancelAutoClose(); userClosed = true; isHovering = false; collapse(); }
    });

    // Click a link -> DON'T collapse, just let the page scroll
    // Collapse will happen naturally via mouseleave when user moves away

    // Visibility
    function updateIslandVisibility() {
      if (window.scrollY > 200) {
        island!.classList.remove('island-hidden');
      } else {
        island!.classList.add('island-hidden');
        if (isOpen) { cancelAutoClose(); collapse(); }
      }
    }

    // Progress
    function updateProgress() {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.round((window.scrollY / docHeight) * 100) : 0;
      if (progress) progress.textContent = pct + '%';
    }

    // Intersection observer
    if (currentObserver) (currentObserver as IntersectionObserver).disconnect();

    currentObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const newSlug = entry.target.id;
            links.forEach((l) => l.classList.remove('active'));
            const active = document.querySelector(`.toc-link[data-toc-slug="${newSlug}"]`);
            if (active) {
              active.classList.add('active');
              // Auto-scroll active link into view when panel is open
              if (isOpen) {
                (active as HTMLElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
              }
            }
            // Flash open on section change
            if (newSlug !== lastActiveSlug) {
              lastActiveSlug = newSlug;
              flashOpen();
            }
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    links.forEach((link) => {
      const slug = (link as HTMLElement).dataset.tocSlug;
      if (slug) {
        const heading = document.getElementById(slug);
        if (heading) currentObserver!.observe(heading);
      }
    });

    // Track hover state — never auto-collapse while hovering
    capsule!.addEventListener('mouseenter', () => {
      isHovering = true;
      cancelAutoClose();
    });
    capsule!.addEventListener('mouseleave', () => {
      isHovering = false;
      // Only auto-close if it was opened by flashOpen, not by user click
      if (isOpen && !manualOpen) scheduleAutoClose(1500);
    });

    // Init
    island.classList.add('island-hidden');
    updateIslandVisibility();
    updateProgress();

    window.addEventListener('scroll', () => {
      updateIslandVisibility();
      updateProgress();
    }, { passive: true });
  }

  initTocIsland();
  document.addEventListener('astro:after-swap', initTocIsland);
</script>
