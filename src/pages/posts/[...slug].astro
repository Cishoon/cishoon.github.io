---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// 计算字数和阅读时间
const wordCount = post.body.replace(/\s+/g, '').length;
const readingTime = Math.max(1, Math.ceil(wordCount / 400));

const tocHeadings = headings.filter(h => h.depth <= 3);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="max-w-3xl mx-auto">
    <article>
      <!-- 文章头部 -->
      <header class="mb-10">
        <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 mb-4 leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}
            </time>
          </span>

          {post.data.categories && post.data.categories.length > 0 && (
            <>
              <span>|</span>
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                {post.data.categories.join(', ')}
              </span>
            </>
          )}

          <span>|</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            {wordCount}
          </span>

          <span>|</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {readingTime}分钟
          </span>

          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span>|</span>
              <span class="inline-flex items-center gap-1.5 flex-wrap">
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`} class="hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors inline-flex items-center gap-0.5"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>{tag}</a>
                ))}
              </span>
            </>
          )}
        </div>
      </header>

      <!-- 文章正文 -->
      <div class="prose prose-zinc prose-lg max-w-none dark:prose-invert
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-zinc-800 dark:prose-headings:text-zinc-100
        prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:text-indigo-500 dark:hover:prose-a:text-indigo-300
        prose-pre:bg-zinc-100 dark:prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-200 dark:prose-pre:border-zinc-800
        prose-code:text-indigo-600 dark:prose-code:text-indigo-300 prose-code:bg-zinc-100 dark:prose-code:bg-zinc-900/50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
        prose-img:rounded-xl prose-img:border prose-img:border-zinc-200 dark:prose-img:border-zinc-800"
      >
        <Content />
      </div>
    </article>
  </div>

  <!-- Floating TOC Dynamic Island -->
  {tocHeadings.length > 0 && (
    <div id="toc-island" class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-end">
      <!-- Collapsed pill (default state) -->
      <button
        id="toc-toggle"
        class="toc-pill group flex items-center gap-2 px-3 py-2.5 bg-white/80 dark:bg-zinc-900/50 backdrop-blur-xl border border-zinc-200/50 dark:border-white/5 rounded-full shadow-lg dark:shadow-black/50 ring-1 ring-zinc-900/5 dark:ring-white/10 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:shadow-xl hover:scale-105 active:scale-95"
        aria-label="Toggle table of contents"
      >
        <!-- List icon -->
        <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <!-- Progress indicator -->
        <span id="toc-progress" class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 tabular-nums min-w-[2ch] text-center">0%</span>
      </button>

      <!-- Expanded panel -->
      <nav
        id="toc-panel"
        class="toc-panel mt-2 w-64 max-h-[60vh] overflow-y-auto overscroll-contain bg-white/80 dark:bg-zinc-900/50 backdrop-blur-xl border border-zinc-200/50 dark:border-white/5 rounded-2xl shadow-lg dark:shadow-black/50 ring-1 ring-zinc-900/5 dark:ring-white/10 p-4 origin-top-right"
      >
        <div class="flex items-center justify-between mb-3">
          <p class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">On this page</p>
          <button id="toc-close" class="p-1 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800" aria-label="Close table of contents">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <ul class="space-y-0.5">
          {tocHeadings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                data-depth={h.depth}
                class="toc-link group/item flex items-center gap-2 py-1 rounded-lg px-2 -mx-1 transition-all duration-300 hover:bg-zinc-100/80 dark:hover:bg-white/5 text-zinc-500 dark:text-zinc-500"
                style={`padding-left: ${0.5 + (h.depth - 1) * 0.75}rem`}
              >
                <span class="toc-dot w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700 flex-shrink-0 transition-all duration-500"></span>
                <span class="text-[13px] leading-snug truncate transition-colors duration-300 group-hover/item:text-zinc-800 dark:group-hover/item:text-zinc-200">
                  {h.text}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}
</BaseLayout>

<style>
  /* Panel animation states */
  #toc-panel {
    opacity: 0;
    transform: scale(0.9) translateY(-8px);
    pointer-events: none;
    transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  #toc-panel.open {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  /* Hide pill when panel is open */
  #toc-toggle.hidden-pill {
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  /* Island hidden state (scrolled to top / no content) */
  #toc-island.island-hidden {
    opacity: 0;
    transform: translate(0, -50%) scale(0.8);
    pointer-events: none;
  }

  #toc-island {
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Active TOC link */
  .toc-link.active {
    color: var(--color-indigo-600, #4f46e5);
    background-color: rgba(99, 102, 241, 0.06);
  }

  :root.dark .toc-link.active {
    color: rgb(129, 140, 248);
    background-color: rgba(99, 102, 241, 0.08);
  }

  .toc-link.active .toc-dot {
    background-color: rgb(99, 102, 241);
    width: 6px;
    height: 6px;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.5);
  }

  /* Scrollbar for TOC panel */
  #toc-panel::-webkit-scrollbar {
    width: 3px;
  }
  #toc-panel::-webkit-scrollbar-track {
    background: transparent;
  }
  #toc-panel::-webkit-scrollbar-thumb {
    background: rgba(161, 161, 170, 0.3);
    border-radius: 10px;
  }

  /* Responsive: hide on small screens */
  @media (max-width: 1024px) {
    #toc-island {
      right: 0.75rem;
    }
  }
  @media (max-width: 640px) {
    #toc-island {
      display: none;
    }
  }
</style>

<script>
  function initTocIsland() {
    const island = document.getElementById('toc-island');
    const toggle = document.getElementById('toc-toggle');
    const panel = document.getElementById('toc-panel');
    const closeBtn = document.getElementById('toc-close');
    const progress = document.getElementById('toc-progress');
    const links = document.querySelectorAll('.toc-link');

    if (!island || !toggle || !panel) return;

    let isOpen = false;
    let currentObserver: IntersectionObserver | null = null;

    // Show/hide island based on scroll position
    function updateIslandVisibility() {
      if (window.scrollY > 200) {
        island!.classList.remove('island-hidden');
      } else {
        island!.classList.add('island-hidden');
        if (isOpen) closeToc();
      }
    }

    // Reading progress
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.round((scrollTop / docHeight) * 100) : 0;
      if (progress) progress.textContent = pct + '%';
    }

    function openToc() {
      isOpen = true;
      panel!.classList.add('open');
      toggle!.classList.add('hidden-pill');
    }

    function closeToc() {
      isOpen = false;
      panel!.classList.remove('open');
      toggle!.classList.remove('hidden-pill');
    }

    toggle!.addEventListener('click', () => {
      if (isOpen) closeToc(); else openToc();
    });

    closeBtn?.addEventListener('click', closeToc);

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (isOpen && !island!.contains(e.target as Node)) {
        closeToc();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeToc();
    });

    // Click a link -> close panel
    links.forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(closeToc, 150);
      });
    });

    // Intersection observer for active heading
    if (currentObserver) (currentObserver as IntersectionObserver).disconnect();

    currentObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            const active = document.querySelector(`.toc-link[data-toc-slug="${entry.target.id}"]`);
            if (active) {
              active.classList.add('active');
              // Auto-scroll the panel to keep active link visible
              if (isOpen && panel) {
                const linkEl = active as HTMLElement;
                const panelRect = panel.getBoundingClientRect();
                const linkRect = linkEl.getBoundingClientRect();
                if (linkRect.top < panelRect.top || linkRect.bottom > panelRect.bottom) {
                  linkEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
              }
            }
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    links.forEach((link) => {
      const slug = (link as HTMLElement).dataset.tocSlug;
      if (slug) {
        const heading = document.getElementById(slug);
        if (heading) currentObserver!.observe(heading);
      }
    });

    // Initial state
    island.classList.add('island-hidden');
    updateIslandVisibility();
    updateProgress();

    window.addEventListener('scroll', () => {
      updateIslandVisibility();
      updateProgress();
    }, { passive: true });
  }

  initTocIsland();
  document.addEventListener('astro:after-swap', initTocIsland);
</script>
