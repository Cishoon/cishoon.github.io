</BaseLayout>

<script is:inline>
  (function() {
    // 防止重复注册事件监听器
    if (window.__homePageInitialized) return;
    window.__homePageInitialized = true;

    let typewriterTimeoutId = null;
    let lastWasMobile = null;
    let statusDotAnimationId = null;
    let mouseX = -9999;
    let mouseY = -9999;

    function initStatusDot() {
      const dot = document.getElementById('status-dot');
      if (!dot) return;

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      if (statusDotAnimationId !== null) {
        cancelAnimationFrame(statusDotAnimationId);
      }

      let dotX = 0;
      let dotY = 0;
      let velX = 0;
      let velY = 0;
      
      const springStrength = 0.05;
      const friction = 0.85;
      const repelRadius = 5;
      const repelForce = 3.0;

      function animate() {
        if (!dot) return;
        
        const rect = dot.getBoundingClientRect();
        const currentCenterX = rect.left + rect.width / 2;
        const currentCenterY = rect.top + rect.height / 2;

        const dx = currentCenterX - mouseX;
        const dy = currentCenterY - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        let forceX = 0;
        let forceY = 0;

        if (dist < repelRadius) {
          const power = (repelRadius - dist) / repelRadius; 
          const angle = Math.atan2(dy, dx);
          forceX = Math.cos(angle) * power * repelForce;
          forceY = Math.sin(angle) * power * repelForce;
        }

        const springX = -dotX * springStrength;
        const springY = -dotY * springStrength;

        velX += forceX + springX;
        velY += forceY + springY;

        velX *= friction;
        velY *= friction;

        dotX += velX;
        dotY += velY;

        dot.style.transform = `translate(${dotX}px, ${dotY}px)`;
        statusDotAnimationId = requestAnimationFrame(animate);
      }

      animate();
    }

    function initTypewriter() {
      const element = document.getElementById("typewriter");
      if (!element) return;

      if (typewriterTimeoutId !== null) {
        clearTimeout(typewriterTimeoutId);
        typewriterTimeoutId = null;
      }

      element.innerHTML = '';

      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const phrases = isMobile 
        ? ["NEVER LIMIT YOURSELF"] 
        : ["STAY COOL", "NEVER LIMIT YOURSELF"];
      
      let loopNum = 0;
      let isDeleting = false;
      let txt = '';
      
      function tick() {
        if (!element) return;
        
        const i = loopNum % phrases.length;
        const fullTxt = phrases[i];

        if (isDeleting) {
          txt = fullTxt.substring(0, txt.length - 1);
        } else {
          txt = fullTxt.substring(0, txt.length + 1);
        }

        element.innerHTML = txt;

        let delta = 100;

        if (isDeleting) { delta /= 2; }

        if (!isDeleting && txt === fullTxt) {
          if (phrases.length === 1) return;
          
          delta = 10000;
          isDeleting = true;
        } else if (isDeleting && txt === '') {
          isDeleting = false;
          loopNum++;
          delta = 500;
        }

        typewriterTimeoutId = setTimeout(tick, delta);
      }
      
      tick();
    }

    function initAvatar() {
      const avatar = document.getElementById('avatar-img');
      if (!avatar) return;
      
      const hour = new Date().getHours();
      if (hour >= 6 && hour < 18) {
        avatar.src = '/avatar/sunrise.png';
      } else {
        avatar.src = '/avatar/sunset.png';
      }
    }

    function cleanupHomePage() {
      if (typewriterTimeoutId !== null) {
        clearTimeout(typewriterTimeoutId);
        typewriterTimeoutId = null;
      }
      if (statusDotAnimationId !== null) {
        cancelAnimationFrame(statusDotAnimationId);
        statusDotAnimationId = null;
      }
    }

    function initHomePage() {
      // 先清理
      cleanupHomePage();
      
      // 只在主页初始化这些功能
      if (window.location.pathname !== '/') return;
      
      lastWasMobile = window.matchMedia('(max-width: 768px)').matches;
      initTypewriter();
      initAvatar();
      initStatusDot();
    }

    // 初始加载
    initHomePage();

    // View Transitions 后重新初始化
    document.addEventListener('astro:after-swap', initHomePage);
  })();
</script>