          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-12 animate-bounce">
      <svg class="w-6 h-6 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="py-20 border-zinc-200 dark:border-white/5">
    <div class="mb-12 flex items-baseline justify-between">
      <h2 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">Latest Logs</h2>
      <a href="/posts" class="text-xs font-mono text-zinc-500 hover:text-indigo-500 transition-colors">VIEW ARCHIVE →</a>
    </div>

    <div class="space-y-16">
      {posts.map((post) => (
        <article class="group relative flex flex-col md:flex-row gap-8 items-baseline">
          
          <div class="md:w-32 flex-shrink-0 md:sticky md:top-32">
            <time datetime={post.data.date.toISOString()} class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}
            </time>
          </div>

          <div class="flex-1 border-l border-zinc-200 dark:border-zinc-800 pl-8 relative">
            <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 bg-zinc-200 dark:bg-zinc-800 rounded-full border-2 border-white dark:border-zinc-950 group-hover:bg-indigo-500 group-hover:border-indigo-400 transition-colors"></div>
            
            <a href={`/posts/${post.slug}`} class="block group-hover:translate-x-1 transition-transform duration-300">
              <h3 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100 mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {post.data.title}
              </h3>
              
              <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 text-sm">
                {post.data.description || getExcerpt(post.body)}
              </p>

              <div class="flex items-center gap-4">
                 <span class="text-xs font-mono text-indigo-500 font-medium group-hover:underline decoration-indigo-500/30 underline-offset-4">Read Article</span>
                 {post.data.tags && (
                    <div class="flex gap-2">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="text-[10px] text-zinc-400">#{tag}</span>
                      ))}
                    </div>
                 )}
              </div>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  let typewriterTimeoutId: number | null = null;
  let lastWasMobile: boolean | null = null;

  function initTypewriter() {
    const element = document.getElementById("typewriter");
    if (!element) return;

    // 清除之前的定时器
    if (typewriterTimeoutId !== null) {
      clearTimeout(typewriterTimeoutId);
      typewriterTimeoutId = null;
    }

    // 重置内容
    element.innerHTML = '';

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const phrases = isMobile 
      ? ["NEVER LIMIT YOURSELF"] 
      : ["STAY COOL", "NEVER LIMIT YOURSELF"];
    
    let loopNum = 0;
    let isDeleting = false;
    let txt = '';
    
    function tick() {
      const i = loopNum % phrases.length;
      const fullTxt = phrases[i];

      if (isDeleting) {
        txt = fullTxt.substring(0, txt.length - 1);
      } else {
        txt = fullTxt.substring(0, txt.length + 1);
      }

      element.innerHTML = txt;

      let delta = 100; // Typing speed

      if (isDeleting) { delta /= 2; } // Deleting speed

      if (!isDeleting && txt === fullTxt) {
        // If only one phrase, stop here (don't delete)
        if (phrases.length === 1) return;
        
        delta = 10000; // Wait 10 seconds
        isDeleting = true;
      } else if (isDeleting && txt === '') {
        isDeleting = false;
        loopNum++;
        delta = 500; // Pause before typing next
      }

      typewriterTimeoutId = setTimeout(tick, delta) as unknown as number;
    }
    
    tick();
  }

  function initAvatar() {
    const avatar = document.getElementById('avatar-img') as HTMLImageElement;
    if (!avatar) return;
    
    const hour = new Date().getHours();
    if (hour >= 6 && hour < 18) {
      avatar.src = '/avatar/sunrise.png';
    } else {
      avatar.src = '/avatar/sunset.png';
    }
  }

  function handleResize() {
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    
    // 只有当模式真正切换时才重新初始化
    if (lastWasMobile !== null && lastWasMobile !== isMobile) {
      initTypewriter();
    }
    
    lastWasMobile = isMobile;
  }

  document.addEventListener('astro:page-load', () => {
    lastWasMobile = window.matchMedia('(max-width: 768px)').matches;
    initTypewriter();
    initAvatar();
    
    // 监听窗口大小变化
    window.addEventListener('resize', handleResize);
  });
</script>