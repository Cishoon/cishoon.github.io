          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-12 animate-bounce">
      <svg class="w-6 h-6 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="py-20 border-zinc-200 dark:border-white/5">
    <div class="mb-12 flex items-baseline justify-between">
      <h2 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">Latest Logs</h2>
      <a href="/posts" class="text-xs font-mono text-zinc-500 hover:text-indigo-500 transition-colors">VIEW ARCHIVE →</a>
    </div>

    <div class="space-y-16">
      {posts.map((post) => (
        <article class="group relative flex flex-col md:flex-row gap-8 items-baseline">
          
          <div class="md:w-32 flex-shrink-0 md:sticky md:top-32">
            <time datetime={post.data.date.toISOString()} class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}
            </time>
          </div>

          <div class="flex-1 border-l border-zinc-200 dark:border-zinc-800 pl-8 relative">
            <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 bg-zinc-200 dark:bg-zinc-800 rounded-full border-2 border-white dark:border-zinc-950 group-hover:bg-indigo-500 group-hover:border-indigo-400 transition-colors"></div>
            
            <a href={`/posts/${post.slug}`} class="block group-hover:translate-x-1 transition-transform duration-300">
              <h3 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100 mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {post.data.title}
              </h3>
              
              <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4 text-sm">
                {post.data.description || getExcerpt(post.body)}
              </p>

              <div class="flex items-center gap-4">
                 <span class="text-xs font-mono text-indigo-500 font-medium group-hover:underline decoration-indigo-500/30 underline-offset-4">Read Article</span>
                 {post.data.tags && (
                    <div class="flex gap-2">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="text-[10px] text-zinc-400 inline-flex items-center gap-0.5"><svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>{tag}</span>
                      ))}
                    </div>
                 )}
              </div>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>

<script is:inline>
  (function() {
    // 防止重复注册事件监听器
    if (window.__homePageInitialized) return;
    window.__homePageInitialized = true;

    let typewriterTimeoutId = null;
    let lastWasMobile = null;
    let statusDotAnimationId = null;
    let mouseX = -9999;
    let mouseY = -9999;

    function initStatusDot() {
      const dot = document.getElementById('status-dot');
      if (!dot) return;

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      if (statusDotAnimationId !== null) {
        cancelAnimationFrame(statusDotAnimationId);
      }

      let dotX = 0;
      let dotY = 0;
      let velX = 0;
      let velY = 0;
      
      const springStrength = 0.05;
      const friction = 0.85;
      const repelRadius = 5;
      const repelForce = 3.0;

      function animate() {
        if (!dot) return;
        
        const rect = dot.getBoundingClientRect();
        const currentCenterX = rect.left + rect.width / 2;
        const currentCenterY = rect.top + rect.height / 2;

        const dx = currentCenterX - mouseX;
        const dy = currentCenterY - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        let forceX = 0;
        let forceY = 0;

        if (dist < repelRadius) {
          const power = (repelRadius - dist) / repelRadius; 
          const angle = Math.atan2(dy, dx);
          forceX = Math.cos(angle) * power * repelForce;
          forceY = Math.sin(angle) * power * repelForce;
        }

        const springX = -dotX * springStrength;
        const springY = -dotY * springStrength;

        velX += forceX + springX;
        velY += forceY + springY;

        velX *= friction;
        velY *= friction;

        dotX += velX;
        dotY += velY;

        dot.style.transform = `translate(${dotX}px, ${dotY}px)`;
        statusDotAnimationId = requestAnimationFrame(animate);
      }

      animate();
    }

    function initTypewriter() {
      const element = document.getElementById("typewriter");
      if (!element) return;

      if (typewriterTimeoutId !== null) {
        clearTimeout(typewriterTimeoutId);
        typewriterTimeoutId = null;
      }

      element.innerHTML = '';

      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const phrases = isMobile 
        ? ["NEVER LIMIT YOURSELF"] 
        : ["STAY COOL", "NEVER LIMIT YOURSELF"];
      
      let loopNum = 0;
      let isDeleting = false;
      let txt = '';
      
      function tick() {
        if (!element) return;
        
        const i = loopNum % phrases.length;
        const fullTxt = phrases[i];

        if (isDeleting) {
          txt = fullTxt.substring(0, txt.length - 1);
        } else {
          txt = fullTxt.substring(0, txt.length + 1);
        }

        element.innerHTML = txt;

        let delta = 100;

        if (isDeleting) { delta /= 2; }

        if (!isDeleting && txt === fullTxt) {
          if (phrases.length === 1) return;
          
          delta = 10000;
          isDeleting = true;
        } else if (isDeleting && txt === '') {
          isDeleting = false;
          loopNum++;
          delta = 500;
        }

        typewriterTimeoutId = setTimeout(tick, delta);
      }
      
      tick();
    }

    function initAvatar() {
      const avatar = document.getElementById('avatar-img');
      if (!avatar) return;
      
      const hour = new Date().getHours();
      if (hour >= 6 && hour < 18) {
        avatar.src = '/avatar/sunrise.png';
      } else {
        avatar.src = '/avatar/sunset.png';
      }
    }

    function cleanupHomePage() {
      if (typewriterTimeoutId !== null) {
        clearTimeout(typewriterTimeoutId);
        typewriterTimeoutId = null;
      }
      if (statusDotAnimationId !== null) {
        cancelAnimationFrame(statusDotAnimationId);
        statusDotAnimationId = null;
      }
    }

    function initHomePage() {
      // 先清理
      cleanupHomePage();
      
      // 只在主页初始化这些功能
      if (window.location.pathname !== '/') return;
      
      lastWasMobile = window.matchMedia('(max-width: 768px)').matches;
      initTypewriter();
      initAvatar();
      initStatusDot();
    }

    // 初始加载
    initHomePage();

    // View Transitions 后重新初始化
    document.addEventListener('astro:after-swap', initHomePage);
  })();
</script>