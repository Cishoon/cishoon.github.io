---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = allPosts.slice(0, 5);

// 精选博客：frontmatter categories 包含 '博客' 的文章
const blogPosts = allPosts.filter(p => p.data.categories?.includes('博客'));

// 随手笔记：按目录聚合非博客文章
const notesCategoryMap = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.categories?.includes('博客')) continue;
  const dir = post.slug.split('/')[0];
  notesCategoryMap.set(dir, (notesCategoryMap.get(dir) || 0) + 1);
}
const notesCategories = [...notesCategoryMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

function getExcerpt(body: string) {
  // 1. 尝试取 <!--more--> 之前的内容
  const moreMatch = body.split(/<!--\s*more\s*-->/);
  let raw = '';
  if (moreMatch.length > 1) {
    raw = moreMatch[0];
  } else {
    // 2. 否则取第一段（跳过空行和标题行）
    const lines = body.split('\n');
    const para: string[] = [];
    let started = false;
    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed || trimmed.startsWith('#')) {
        if (started) break;
        continue;
      }
      started = true;
      para.push(trimmed);
    }
    raw = para.join(' ');
  }
  // 清理 markdown 语法
  return raw
    .replace(/^---[\s\S]*?---\s*/m, '') // 去掉 frontmatter
    .replace(/!\[.*?\]\(.*?\)/g, '')     // 去掉图片
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')  // 链接只保留文字
    .replace(/[#*`>]/g, '')              // 去掉 markdown 符号
    .replace(/\n+/g, ' ')               // 换行变空格
    .trim()
    .slice(0, 200) + (raw.length > 200 ? '...' : '');
}
