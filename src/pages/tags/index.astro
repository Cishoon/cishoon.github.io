---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const tagCounts = posts.reduce((acc, post) => {
  post.data.tags?.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 text-center">
      <h1 class="text-3xl font-bold text-zinc-100 tracking-tight mb-4">Topics</h1>
      <p class="text-zinc-500 font-mono text-sm">Explore {sortedTags.length} different topics</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {sortedTags.map(([tag, count]) => (
        <a 
          href={`/tags/${tag}`} 
          class="group flex items-center justify-between p-4 bg-zinc-900/30 border border-white/5 rounded-xl hover:border-indigo-500/30 hover:bg-zinc-800/50 transition-all duration-300"
        >
          <span class="text-sm font-medium text-zinc-300 group-hover:text-indigo-300 transition-colors truncate">#{tag}</span>
          <span class="text-xs font-mono text-zinc-600 group-hover:text-zinc-400 bg-zinc-900 px-2 py-0.5 rounded-md border border-zinc-800 group-hover:border-zinc-700">
            {count}
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
