---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cishoon's Blog" } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/posts' },
  { name: 'Tags', href: '/tags' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Cishoon</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    <ClientRouter />
    
    <!-- Theme Init -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-[var(--color-canvas)] text-zinc-800 dark:text-zinc-300 relative min-h-screen transition-colors duration-500 overflow-x-hidden">
    
    <!-- Background Layer -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="bg-noise absolute inset-0 mix-blend-overlay opacity-20 dark:opacity-20"></div>
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-indigo-300/30 dark:bg-indigo-900/20 rounded-full blur-[120px] animate-pulse-slow"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[600px] h-[600px] bg-purple-300/30 dark:bg-zinc-800/20 rounded-full blur-[120px]"></div>
      <div id="spotlight" class="absolute inset-0 bg-transparent transition-opacity duration-500 opacity-0 lg:opacity-100"></div>
    </div>

    <!-- Top Dynamic Island Nav -->
    <nav id="nav-wrapper" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 transition-[top] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]" transition:persist>
      <div id="nav-container" class="group flex items-center justify-center p-1.5 bg-white/80 dark:bg-zinc-900/50 backdrop-blur-xl border border-zinc-200/50 dark:border-white/5 rounded-full shadow-lg dark:shadow-black/50 ring-1 ring-zinc-900/5 dark:ring-white/10 transition-[max-width,padding,background] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:duration-400 hover:ease-[cubic-bezier(0.22,1,0.36,1)] h-12 max-w-[3rem] hover:max-w-[18rem] hover:px-4 [&.expanded]:max-w-[18rem] [&.expanded]:px-4 overflow-hidden">
        
        <!-- Logo -->
        <a href="/" data-astro-prefetch class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-zinc-100 dark:bg-zinc-800 rounded-full text-zinc-800 dark:text-zinc-200 hover:bg-indigo-500 hover:text-white transition-colors duration-300">
          <span class="font-bold font-mono text-sm">C</span>
        </a>

        <!-- Menu Items -->
        <div id="nav-menu" class="flex items-center gap-1 opacity-0 group-hover:opacity-100 group-[.expanded]:opacity-100 transition-opacity duration-300 ease-out ml-2 whitespace-nowrap">
          {navItems.map((item) => (
            <a 
              href={item.href} 
              data-nav-item
              data-href={item.href}
              data-astro-prefetch
              class="nav-link px-3 py-1.5 text-xs font-medium transition-colors rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/5"
            >
              {item.name}
            </a>
          ))}
          <div class="w-[1px] h-3 bg-zinc-300 dark:bg-zinc-700 mx-1"></div>
          <button id="theme-toggle" class="p-1.5 text-zinc-500 dark:text-zinc-400 hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors" aria-label="Toggle Theme">
             <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
             <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="relative z-10 w-full max-w-4xl mx-auto px-6 pt-24 pb-24 lg:pt-28 lg:pb-32">
      <slot />
    </main>

    <footer class="relative z-10 py-8 text-center">
       <p class="text-[10px] text-zinc-400 dark:text-zinc-600 font-mono tracking-widest uppercase opacity-70">Designed by Cishoon</p>
    </footer>

    <style is:global>
      /* Docked State Logic */
      #nav-wrapper.docked {
        top: -2.5rem; /* Half height (24px) visible */
      }
      
      #nav-wrapper.docked:hover,
      #nav-wrapper.scroll-visible {
        top: 1.5rem; /* Restore to original top-6 (24px) */
      }

      /* Bridge to prevent flickering when hovering from top edge */
      #nav-wrapper.docked::before {
        content: '';
        position: absolute;
        top: -50px;
        left: 50%;
        transform: translateX(-50%);
        width: 22rem;
        height: calc(100% + 100px);
      }

      /* When hovering the wrapper (including the ::before area), expand nav-container */
      #nav-wrapper.docked:hover #nav-container,
      #nav-wrapper.scroll-visible #nav-container {
        max-width: 18rem;
        padding-left: 1rem;
        padding-right: 1rem;
      }
      
      #nav-wrapper.docked:hover #nav-menu,
      #nav-wrapper.scroll-visible #nav-menu {
        opacity: 1;
      }
    </style>

    <script>
      // Scroll direction detection
      let lastScrollY = 0;
      let scrollUpDistance = 0;
      let scrollDownDistance = 0;
      const SCROLL_THRESHOLD = 80; // 需要滚动多少距离才触发显示/隐藏
      
      // Navigation State Logic
      function updateNavState() {
        const nav = document.getElementById('nav-container');
        const navWrapper = document.getElementById('nav-wrapper');
        if (!nav || !navWrapper) return;
        
        // Check if we are on a "special" page (blog/tags/post)
        const isSpecialPage = /^\/(posts|tags)/.test(window.location.pathname);
        const currentScrollY = window.scrollY;
        const isScrolled = currentScrollY > 50; // Threshold for docking
        
        // 计算滚动方向和距离
        const scrollDelta = currentScrollY - lastScrollY;
        
        if (scrollDelta < 0) {
          // 向上滚动
          scrollUpDistance += Math.abs(scrollDelta);
          scrollDownDistance = 0;
        } else if (scrollDelta > 0) {
          // 向下滚动
          scrollDownDistance += scrollDelta;
          scrollUpDistance = 0;
        }
        
        lastScrollY = currentScrollY;
        
        if (!isScrolled) {
          // 在页面顶部，始终展开导航
          navWrapper.classList.remove('docked');
          navWrapper.classList.remove('scroll-visible');
          nav.classList.add('expanded');
        } else {
          // 已滚动，根据滚动方向决定显示/隐藏
          nav.classList.remove('expanded');
          
          if (scrollUpDistance > SCROLL_THRESHOLD) {
            // 向上滚动足够距离，显示导航
            navWrapper.classList.add('scroll-visible');
            navWrapper.classList.remove('docked');
          } else if (scrollDownDistance > SCROLL_THRESHOLD) {
            // 向下滚动足够距离，隐藏导航
            navWrapper.classList.remove('scroll-visible');
            navWrapper.classList.add('docked');
          }
        }
      }

      // Update active nav link based on current path
      function updateActiveNavLink() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('[data-nav-item]');
        
        const activeClasses = ['bg-zinc-200/80', 'dark:bg-white/10', 'text-zinc-900', 'dark:text-white'];
        const inactiveClasses = ['text-zinc-600', 'dark:text-zinc-400'];
        
        navLinks.forEach((link) => {
          const href = link.getAttribute('data-href');
          const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href!);
          
          if (isActive) {
            link.classList.remove(...inactiveClasses);
            link.classList.add(...activeClasses);
          } else {
            link.classList.remove(...activeClasses);
            link.classList.add(...inactiveClasses);
          }
        });
      }
      
      // Run once on load
      window.addEventListener('scroll', updateNavState, { passive: true });

      function initInteractive() {
        const spotlight = document.getElementById('spotlight');
        if (spotlight) {
          window.addEventListener('mousemove', e => {
             spotlight.style.setProperty('--x', `${e.clientX}px`);
             spotlight.style.setProperty('--y', `${e.clientY}px`);
          });
        }

        const themeToggleBtn = document.getElementById('theme-toggle');
        const handleToggleClick = () => {
          const element = document.documentElement;
          element.classList.toggle("dark");
          const isDark = element.classList.contains("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        };
        // Remove old listener if exists (optional but good practice)
        themeToggleBtn?.replaceWith(themeToggleBtn.cloneNode(true));
        document.getElementById('theme-toggle')?.addEventListener("click", handleToggleClick);
        
        // Update Nav on interactive init (page load / swap)
        updateNavState();
        updateActiveNavLink();
      }

      // 恢复主题状态（页面切换后 html class 会被重置）
      function restoreTheme() {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      }

      initInteractive();
      
      document.addEventListener('astro:before-swap', (ev) => {
        // Pass the current theme class to the new document to prevent flashing
        if (document.documentElement.classList.contains('dark')) {
          ev.newDocument.documentElement.classList.add('dark');
        } else {
          ev.newDocument.documentElement.classList.remove('dark');
        }
      });

      // 在 swap 之前，提前根据目标 URL 设置好 nav 状态，避免闪烁
      document.addEventListener('astro:before-preparation', (ev) => {
        const navContainer = document.getElementById('nav-container');
        const navWrapper = document.getElementById('nav-wrapper');
        if (!navContainer || !navWrapper) return;

        // 页面切换时始终保持展开，禁用过渡避免闪烁
        navContainer.style.transition = 'none';
        navWrapper.classList.remove('docked', 'scroll-visible');
        navContainer.classList.add('expanded');
        navContainer.offsetHeight;
      });

      document.addEventListener('astro:after-swap', () => {
        // 重置滚动状态
        lastScrollY = 0;
        scrollUpDistance = 0;
        scrollDownDistance = 0;

        // 恢复过渡动画（在下一帧，确保无过渡的状态已经渲染）
        const navContainer = document.getElementById('nav-container');
        if (navContainer) {
          requestAnimationFrame(() => {
            navContainer.style.transition = '';
          });
        }

        restoreTheme();
        initInteractive();
      });
    </script>
  </body>
</html>
