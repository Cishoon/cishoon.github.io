---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cishoon's Blog" } = Astro.props;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/posts' },
  { name: 'Tags', href: '/tags' },
];
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Cishoon</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    <ClientRouter />
    
    <!-- Theme Init -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-[var(--color-canvas)] text-zinc-800 dark:text-zinc-300 relative min-h-screen transition-colors duration-500 overflow-x-hidden">
    
    <!-- Background Layer -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div class="bg-noise absolute inset-0 mix-blend-overlay opacity-20 dark:opacity-20"></div>
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-indigo-300/30 dark:bg-indigo-900/20 rounded-full blur-[120px] animate-pulse-slow"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[600px] h-[600px] bg-purple-300/30 dark:bg-zinc-800/20 rounded-full blur-[120px]"></div>
      <div id="spotlight" class="absolute inset-0 bg-transparent transition-opacity duration-500 opacity-0 lg:opacity-100"></div>
    </div>

    <!-- Top Dynamic Island Nav -->
    <nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50">
      <div class="group flex items-center justify-center p-1.5 bg-white/80 dark:bg-zinc-900/50 backdrop-blur-xl border border-zinc-200/50 dark:border-white/5 rounded-full shadow-lg dark:shadow-black/50 ring-1 ring-zinc-900/5 dark:ring-white/10 transition-[max-width,padding,background] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:duration-400 hover:ease-[cubic-bezier(0.22,1,0.36,1)] h-12 max-w-[3rem] hover:max-w-[18rem] hover:px-4 overflow-hidden">
        
        <!-- Logo -->
        <a href="/" class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-zinc-100 dark:bg-zinc-800 rounded-full text-zinc-800 dark:text-zinc-200 hover:bg-indigo-500 hover:text-white transition-colors duration-300">
          <span class="font-bold font-mono text-sm">C</span>
        </a>

        <!-- Menu Items -->
        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out ml-2 whitespace-nowrap">
          {navItems.map((item) => (
            <a href={item.href} class="px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">
              {item.name}
            </a>
          ))}
          <div class="w-[1px] h-3 bg-zinc-300 dark:bg-zinc-700 mx-1"></div>
          <button id="theme-toggle" class="p-1.5 text-zinc-500 dark:text-zinc-400 hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors" aria-label="Toggle Theme">
             <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
             <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="relative z-10 w-full max-w-4xl mx-auto px-6 py-24 lg:py-32">
      <slot />
    </main>

    <footer class="relative z-10 py-8 text-center">
       <p class="text-[10px] text-zinc-400 dark:text-zinc-600 font-mono tracking-widest uppercase opacity-70">Designed by Cishoon</p>
    </footer>

    <script>
      function initInteractive() {
        const spotlight = document.getElementById('spotlight');
        if (spotlight) {
          window.addEventListener('mousemove', e => {
             spotlight.style.setProperty('--x', `${e.clientX}px`);
             spotlight.style.setProperty('--y', `${e.clientY}px`);
          });
        }

        const themeToggleBtn = document.getElementById('theme-toggle');
        const handleToggleClick = () => {
          const element = document.documentElement;
          element.classList.toggle("dark");
          const isDark = element.classList.contains("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        };
        // Remove old listener if exists (optional but good practice)
        themeToggleBtn?.replaceWith(themeToggleBtn.cloneNode(true));
        document.getElementById('theme-toggle')?.addEventListener("click", handleToggleClick);
      }

      // 恢复主题状态（页面切换后 html class 会被重置）
      function restoreTheme() {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      }

      initInteractive();
      document.addEventListener('astro:after-swap', () => {
        restoreTheme();
        initInteractive();
      });
    </script>
  </body>
</html>
